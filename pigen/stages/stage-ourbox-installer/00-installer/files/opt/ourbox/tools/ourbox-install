#!/usr/bin/env bash
set -euo pipefail

OURBOX_INSTALL_LIBRARY_ONLY="${OURBOX_INSTALL_LIBRARY_ONLY:-0}"
INSTALLER_LOG="${OURBOX_INSTALLER_LOG:-/run/ourbox-installer.log}"
OURBOX_INSTALL_IS_SOURCED=0
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  OURBOX_INSTALL_IS_SOURCED=1
fi

if [[ "${OURBOX_INSTALL_LIBRARY_ONLY}" == "1" && "${OURBOX_INSTALL_IS_SOURCED}" != "1" ]]; then
  printf 'ERROR: OURBOX_INSTALL_LIBRARY_ONLY=1 is supported only when sourcing %s\n' "${BASH_SOURCE[0]}" >&2
  exit 1
fi

TOOLS_ROOT="${OURBOX_INSTALL_TOOLS_ROOT:-/opt/ourbox/tools}"
# shellcheck disable=SC1091
source "${TOOLS_ROOT}/lib.sh"

if [[ "${OURBOX_INSTALL_LIBRARY_ONLY}" != "1" ]] && command -v tee >/dev/null 2>&1; then
  exec > >(tee -a "${INSTALLER_LOG}") 2>&1
fi

need_cmd awk
need_cmd cmp
need_cmd find
need_cmd python3
need_cmd sha256sum
need_cmd tar
if [[ "${OURBOX_INSTALL_LIBRARY_ONLY}" != "1" ]]; then
  need_cmd xz
  need_cmd xzcat
  need_cmd dd
  need_cmd lsblk
  need_cmd readlink
  need_cmd findmnt
  need_cmd blkid
  need_cmd partprobe
  need_cmd wipefs
  need_cmd blockdev
  need_cmd parted
  need_cmd mkfs.ext4
  need_cmd mount
  need_cmd umount
  need_cmd mountpoint
  need_cmd openssl
  need_cmd sync
  need_cmd ip
  need_cmd sort
  need_cmd udevadm
fi

DATA_CHECK_MP="${OURBOX_INSTALL_DATA_CHECK_MP:-/run/ourbox-installer/data-check}"
SYS_BOOT_MP="${OURBOX_INSTALL_SYS_BOOT_MP:-/run/ourbox-installer/sys-boot}"
SYS_ROOT_MP="${OURBOX_INSTALL_SYS_ROOT_MP:-/run/ourbox-installer/sys-root}"
MISSION_ROOT="${OURBOX_INSTALL_MISSION_ROOT:-/opt/ourbox/mission}"
SUBSTRATE_EXTRACT_DIR="${OURBOX_INSTALL_SUBSTRATE_EXTRACT_DIR:-/opt/ourbox/installer/cache/ourbox-substrate}"
DEFAULTS_ENV="${OURBOX_INSTALL_DEFAULTS_ENV:-/opt/ourbox/installer/defaults.env}"

