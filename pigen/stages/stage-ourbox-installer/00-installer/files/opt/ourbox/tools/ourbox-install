INSTALLER_VERSION=""
INSTALLER_GIT_HASH=""
OURBOX_INSTALLER_SSH_TEARDOWN_ON_COMPLETE="0"

OS_ARTIFACT_REF=""
OS_ARTIFACT_DIGEST=""
