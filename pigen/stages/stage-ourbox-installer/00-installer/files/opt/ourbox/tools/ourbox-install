#!/usr/bin/env bash
set -euo pipefail

# shellcheck disable=SC1091
source /opt/ourbox/tools/lib.sh

INSTALLER_LOG="/run/ourbox-installer.log"
if command -v tee >/dev/null 2>&1; then
  exec > >(tee -a "${INSTALLER_LOG}") 2>&1
fi

need_cmd xz
need_cmd xzcat
need_cmd sha256sum
need_cmd dd
need_cmd lsblk
need_cmd readlink
need_cmd findmnt
need_cmd blkid
need_cmd partprobe
need_cmd wipefs
need_cmd blockdev
need_cmd parted
need_cmd mkfs.ext4
need_cmd mount
need_cmd umount
need_cmd mountpoint
need_cmd find
need_cmd openssl
need_cmd sync
need_cmd tar
need_cmd ip
need_cmd sort
need_cmd udevadm
need_cmd python3

DATA_CHECK_MP="/run/ourbox-installer/data-check"
SYS_BOOT_MP="/run/ourbox-installer/sys-boot"
SYS_ROOT_MP="/run/ourbox-installer/sys-root"
MISSION_ROOT="/opt/ourbox/mission"
AIRGAP_EXTRACT_DIR="/opt/ourbox/installer/cache/ourbox-substrate"
DEFAULTS_ENV="/opt/ourbox/installer/defaults.env"

INSTALLER_ID=""
INSTALLER_VERSION=""
INSTALLER_GIT_HASH=""
OURBOX_INSTALLER_SSH_TEARDOWN_ON_COMPLETE="0"

OS_ARTIFACT_REF=""
OS_ARTIFACT_DIGEST=""
OS_ARTIFACT_SOURCE="mission"
PAYLOAD_PATH=""
PAYLOAD_SHA256=""
PAYLOAD_META=""
INSTALL_SELECTION_SOURCE=""
RELEASE_CHANNEL=""
PLATFORM_CONTRACT_DIGEST=""

OURBOX_SUBSTRATE_SOURCE=""
OURBOX_SUBSTRATE_REVISION=""
OURBOX_SUBSTRATE_VERSION=""
OURBOX_SUBSTRATE_CREATED=""
OURBOX_SUBSTRATE_ARCH=""
OURBOX_SUBSTRATE_PROFILE=""
OURBOX_SUBSTRATE_K3S_VERSION=""
OURBOX_SUBSTRATE_IMAGES_LOCK_SHA256=""
OURBOX_SUBSTRATE_ARTIFACT_SOURCE="mission"
OURBOX_SUBSTRATE_REF=""
OURBOX_SUBSTRATE_DIGEST=""
OURBOX_SUBSTRATE_SELECTION_SOURCE=""
OURBOX_SUBSTRATE_RELEASE_CHANNEL=""
AIRGAP_MANIFEST_PATH=""

IDENTITY_USERNAME="ourbox"
IDENTITY_PASSWORD_HASH=""
# shellcheck disable=SC2034  # consumed by sourced storage-flow helper
MATCHBOX_DATA_CHECK_MP="${DATA_CHECK_MP}"

# shellcheck disable=SC1091
source /opt/ourbox/tools/matchbox-storage-flow.sh

cleanup_mounts() {
  matchbox_cleanup_data_check_mp
  if mountpoint -q "${SYS_BOOT_MP}"; then
    umount "${SYS_BOOT_MP}" >/dev/null 2>&1 || true
  fi
  if mountpoint -q "${SYS_ROOT_MP}"; then
    umount "${SYS_ROOT_MP}" >/dev/null 2>&1 || true
  fi
}

cleanup_temp() {
  rm -rf "${AIRGAP_EXTRACT_DIR}"
}

finalize() {
  local rc=$?
  trap - EXIT
  cleanup_mounts

  echo
  if [[ "${rc}" -eq 0 ]]; then
    log "Installer finished (success). Powering off now."
    sync || true
    systemctl poweroff || /sbin/poweroff || true
    exit 0
  fi

  log "ERROR: Installer failed (rc=${rc})."
  log "Dropping to an interactive shell for debugging."
  log "Installer log is available at ${INSTALLER_LOG}"
  log "When you're done, type: poweroff"

  exec /bin/bash -l
}
trap finalize EXIT

confirm_exact_answer() {
  local expected="$1"
  local prompt="$2"
  local ans=""

  read -r -p "${prompt} " ans
  [[ "${ans}" == "${expected}" ]]
}

prompt_confirm_exact() {
  local expected="$1"
  local prompt="$2"
  confirm_exact_answer "${expected}" "${prompt}" \
    || die "confirmation did not match (expected: ${expected})"
}

prompt_nonempty() {
  local prompt="$1"
  local default="${2:-}"
  local ans=""

  if [[ -n "${default}" ]]; then
    read -r -p "${prompt} [${default}]: " ans
    ans="${ans:-${default}}"
  else
    read -r -p "${prompt}: " ans
  fi

  [[ -n "${ans}" ]] || die "value required"
  printf '%s\n' "${ans}"
}

prompt_password_hash() {
  local pw1="" pw2=""

  while true; do
    read -r -s -p "Password: " pw1; echo >&2
    read -r -s -p "Confirm:  " pw2; echo >&2
    [[ -n "${pw1}" ]] || { echo "Password cannot be empty." >&2; continue; }
    [[ "${pw1}" == "${pw2}" ]] || { echo "Passwords did not match. Try again." >&2; continue; }
    printf '%s' "${pw1}" | openssl passwd -6 -stdin
    return 0
  done
}

banner() {
  local ip=""

  ip="$(ip route get 10.255.255.255 2>/dev/null | awk '/src/ {print $7; exit}' || true)"
  echo
  echo "=================================================================="
  echo "OurBox Matchbox Installer"
  echo "=================================================================="
  if [[ -n "${ip}" ]]; then
    echo "Network IP    : ${ip}"
  fi
  echo "Installer log : ${INSTALLER_LOG}"
  echo "Mission root  : ${MISSION_ROOT}"
  echo "=================================================================="
  echo
}

show_install_plan() {
  echo "Install summary:"
  echo "  SYSTEM disk : ${MATCHBOX_SYSTEM_DISK}"
  if [[ -n "${MATCHBOX_SYSTEM_DISK_SERIAL}" ]]; then
    echo "  Disk serial : ${MATCHBOX_SYSTEM_DISK_SERIAL}"
  fi
  echo "  DATA disk   : ${MATCHBOX_DATA_DISK}"
  echo "  DATA action : ${MATCHBOX_DATA_ACTION_SUMMARY}"
  if [[ -n "${MATCHBOX_DATA_PART}" ]]; then
    echo "  DATA part   : ${MATCHBOX_DATA_PART}"
  fi
  echo "  OS artifact : ${OS_ARTIFACT_REF}"
  echo "  Selection   : ${INSTALL_SELECTION_SOURCE:-unknown}"
  if [[ -n "${RELEASE_CHANNEL}" ]]; then
    echo "  Channel     : ${RELEASE_CHANNEL}"
  fi
  echo "  Digest      : ${OS_ARTIFACT_DIGEST:-unknown}"
  echo "  Payload SHA : ${PAYLOAD_SHA256}"
  echo "  Apps bundle : ${OURBOX_SUBSTRATE_REF:-unknown}"
  echo "  Apps source : ${OURBOX_SUBSTRATE_ARTIFACT_SOURCE:-unknown}"
  echo "  Apps select : ${OURBOX_SUBSTRATE_SELECTION_SOURCE:-unknown}"
  if [[ -n "${OURBOX_SUBSTRATE_RELEASE_CHANNEL}" ]]; then
    echo "  Apps lane   : ${OURBOX_SUBSTRATE_RELEASE_CHANNEL}"
  fi
  echo "  Apps digest : ${OURBOX_SUBSTRATE_DIGEST:-unknown}"
  echo "  Contract    : ${PLATFORM_CONTRACT_DIGEST:-unknown}"
  echo "  Username    : ${IDENTITY_USERNAME}"
  if [[ "${MATCHBOX_SYSTEM_DISK_WAS_DATA}" == "1" ]]; then
    echo "  Note        : selected SYSTEM disk currently carries OURBOX_DATA and will be cleared"
  fi
  echo
}

show_completion_summary() {
  echo "Handoff summary:"
  echo "  SYSTEM disk : ${MATCHBOX_SYSTEM_DISK}"
  echo "  DATA disk   : ${MATCHBOX_DATA_DISK}"
  echo "  DATA action : ${MATCHBOX_DATA_ACTION_SUMMARY}"
  echo "  OS artifact : ${OS_ARTIFACT_REF}"
  echo "  Selection   : ${INSTALL_SELECTION_SOURCE:-unknown}"
  if [[ -n "${RELEASE_CHANNEL}" ]]; then
    echo "  Channel     : ${RELEASE_CHANNEL}"
  fi
  echo "  Digest      : ${OS_ARTIFACT_DIGEST:-unknown}"
  echo "  Payload SHA : ${PAYLOAD_SHA256}"
  echo "  Apps bundle : ${OURBOX_SUBSTRATE_REF:-unknown}"
  echo "  Apps source : ${OURBOX_SUBSTRATE_ARTIFACT_SOURCE:-unknown}"
  echo "  Apps select : ${OURBOX_SUBSTRATE_SELECTION_SOURCE:-unknown}"
  if [[ -n "${OURBOX_SUBSTRATE_RELEASE_CHANNEL}" ]]; then
    echo "  Apps lane   : ${OURBOX_SUBSTRATE_RELEASE_CHANNEL}"
  fi
  echo "  Apps digest : ${OURBOX_SUBSTRATE_DIGEST:-unknown}"
  echo "  Contract    : ${PLATFORM_CONTRACT_DIGEST:-unknown}"
  echo "  Username    : ${IDENTITY_USERNAME}"
  echo
}

matchbox_partition_path() {
  local disk="$1"
  local part_num="$2"

  if [[ "${disk}" =~ [0-9]$ ]]; then
    printf '%s\n' "${disk}p${part_num}"
  else
    printf '%s\n' "${disk}${part_num}"
  fi
}

parse_sha256_file() {
  local file="$1"
  awk 'NF>=1 {print $1; exit}' "${file}"
}

normalize_installer_config() {
  INSTALLER_ID="${INSTALLER_ID:-matchbox}"
  INSTALLER_VERSION="${INSTALLER_VERSION:-unknown}"
  INSTALLER_GIT_HASH="${INSTALLER_GIT_HASH:-unknown}"
  OURBOX_INSTALLER_SSH_TEARDOWN_ON_COMPLETE="${OURBOX_INSTALLER_SSH_TEARDOWN_ON_COMPLETE:-0}"
}

load_installer_config() {
  # shellcheck disable=SC1090
  [[ -f "${DEFAULTS_ENV}" ]] && source "${DEFAULTS_ENV}"
  normalize_installer_config
}

load_local_mission() {
  local mission_dump=""

  [[ -f "${MISSION_ROOT}/mission-manifest.json" ]] || die "mission-manifest.json missing from ${MISSION_ROOT}"

  mission_dump="$(
    python3 - <<'PY' "${MISSION_ROOT}/mission-manifest.json"
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as handle:
    manifest = json.load(handle)

if manifest.get("schema") != 1 or manifest.get("kind") != "ourbox-mission":
    raise SystemExit("mission-manifest.json must declare schema=1 and kind=ourbox-mission")
target = manifest.get("target") or {}
if target.get("id") != "matchbox":
    raise SystemExit("mission target id must be matchbox")

selected_os = manifest.get("selected_os") or {}
selected_airgap = manifest.get("selected_airgap") or {}
platform_contract = manifest.get("platform_contract") or {}

values = [
    str(selected_os.get("selection_source", "")).strip(),
    str(selected_os.get("release_channel", "")).strip(),
    str(selected_os.get("artifact_ref", "")).strip(),
    str(selected_os.get("artifact_digest", "")).strip(),
    str((selected_os.get("payload") or {}).get("relpath", "")).strip(),
    str(selected_os.get("metadata_relpath", "")).strip(),
    str(platform_contract.get("digest", "")).strip(),
    str(selected_airgap.get("selection_source", "")).strip(),
    str(selected_airgap.get("release_channel", "")).strip(),
    str(selected_airgap.get("artifact_ref", "")).strip(),
    str(selected_airgap.get("artifact_digest", "")).strip(),
    str(selected_airgap.get("payload_relpath", "")).strip(),
    str(selected_airgap.get("manifest_relpath", "")).strip(),
]
print("\n".join(values))
PY
  )" || die "failed to parse mission-manifest.json"

  local mission_fields=()
  mapfile -t mission_fields <<<"${mission_dump}"
  [[ "${#mission_fields[@]}" -eq 13 ]] || die "mission-manifest.json parse produced an unexpected field set"

  INSTALL_SELECTION_SOURCE="${mission_fields[0]}"
  RELEASE_CHANNEL="${mission_fields[1]}"
  OS_ARTIFACT_REF="${mission_fields[2]}"
  OS_ARTIFACT_DIGEST="${mission_fields[3]}"
  PAYLOAD_PATH="${MISSION_ROOT}/${mission_fields[4]}"
  PAYLOAD_META="${MISSION_ROOT}/${mission_fields[5]}"
  PLATFORM_CONTRACT_DIGEST="${mission_fields[6]}"
  OURBOX_SUBSTRATE_SELECTION_SOURCE="${mission_fields[7]}"
  OURBOX_SUBSTRATE_RELEASE_CHANNEL="${mission_fields[8]}"
  OURBOX_SUBSTRATE_REF="${mission_fields[9]}"
  OURBOX_SUBSTRATE_DIGEST="${mission_fields[10]}"
  local airgap_payload="${MISSION_ROOT}/${mission_fields[11]}"
  AIRGAP_MANIFEST_PATH="${MISSION_ROOT}/${mission_fields[12]}"

  [[ -f "${PAYLOAD_PATH}" ]] || die "mission OS payload missing: ${PAYLOAD_PATH}"
  [[ -f "${PAYLOAD_META}" ]] || die "mission OS metadata missing: ${PAYLOAD_META}"
  [[ -f "${airgap_payload}" ]] || die "mission application bundle missing: ${airgap_payload}"
  [[ -f "${AIRGAP_MANIFEST_PATH}" ]] || die "mission application bundle manifest missing: ${AIRGAP_MANIFEST_PATH}"
  [[ "${PLATFORM_CONTRACT_DIGEST}" =~ ^sha256:[0-9a-f]{64}$ ]] || die "mission platform contract digest is invalid"

  local payload_sha_file="${PAYLOAD_PATH}.sha256"
  [[ -f "${payload_sha_file}" ]] || die "mission OS payload checksum missing: ${payload_sha_file}"
  PAYLOAD_SHA256="$(parse_sha256_file "${payload_sha_file}")"
  PAYLOAD_SHA256="${PAYLOAD_SHA256,,}"
  [[ "${PAYLOAD_SHA256}" =~ ^[0-9a-f]{64}$ ]] || die "mission OS payload checksum is invalid: ${payload_sha_file}"
  local actual_payload_sha=""
  actual_payload_sha="$(sha256sum "${PAYLOAD_PATH}" | awk '{print $1}')"
  [[ "${PAYLOAD_SHA256}" == "${actual_payload_sha}" ]] || die "mission OS payload SHA mismatch (expected ${PAYLOAD_SHA256}, got ${actual_payload_sha})"

  # shellcheck disable=SC1090
  source "${PAYLOAD_META}"
  [[ "${OURBOX_PLATFORM_CONTRACT_DIGEST:-}" == "${PLATFORM_CONTRACT_DIGEST}" ]] \
    || die "mission OS metadata contract digest mismatch"

  rm -rf "${AIRGAP_EXTRACT_DIR}"
  mkdir -p "${AIRGAP_EXTRACT_DIR}"
  tar -xzf "${airgap_payload}" -C "${AIRGAP_EXTRACT_DIR}"

  [[ -f "${AIRGAP_EXTRACT_DIR}/manifest.env" ]] || die "mission application bundle extract is missing manifest.env"
  [[ -x "${AIRGAP_EXTRACT_DIR}/k3s/k3s" ]] || die "mission application bundle extract is missing k3s/k3s"
  [[ -f "${AIRGAP_EXTRACT_DIR}/k3s/k3s-airgap-images-arm64.tar" ]] \
    || die "mission application bundle extract is missing k3s/k3s-airgap-images-arm64.tar"
  [[ -f "${AIRGAP_EXTRACT_DIR}/platform/images.lock.json" ]] \
    || die "mission application bundle extract is missing platform/images.lock.json"
  [[ -f "${AIRGAP_EXTRACT_DIR}/platform/profile.env" ]] \
    || die "mission application bundle extract is missing platform/profile.env"
  find "${AIRGAP_EXTRACT_DIR}/platform/images" -maxdepth 1 -type f -name '*.tar' | grep -q . \
    || die "mission application bundle extract is missing platform image tars"

  cmp -s "${AIRGAP_EXTRACT_DIR}/manifest.env" "${AIRGAP_MANIFEST_PATH}" \
    || die "mission application bundle manifest does not match tarball manifest.env"

  # shellcheck disable=SC1090
  source "${AIRGAP_MANIFEST_PATH}"
  [[ "${OURBOX_PLATFORM_CONTRACT_DIGEST:-}" == "${PLATFORM_CONTRACT_DIGEST}" ]] \
    || die "mission application bundle contract digest mismatch"
  [[ "${OURBOX_SUBSTRATE_ARCH:-}" == "arm64" ]] \
    || die "mission application bundle arch mismatch: expected arm64, got ${OURBOX_SUBSTRATE_ARCH:-unknown}"

  OURBOX_SUBSTRATE_SOURCE="${OURBOX_SUBSTRATE_SOURCE:-unknown}"
  OURBOX_SUBSTRATE_REVISION="${OURBOX_SUBSTRATE_REVISION:-unknown}"
  OURBOX_SUBSTRATE_VERSION="${OURBOX_SUBSTRATE_VERSION:-unknown}"
  OURBOX_SUBSTRATE_CREATED="${OURBOX_SUBSTRATE_CREATED:-unknown}"
  OURBOX_SUBSTRATE_ARCH="${OURBOX_SUBSTRATE_ARCH:-unknown}"
  OURBOX_SUBSTRATE_PROFILE="${OURBOX_PLATFORM_PROFILE:-unknown}"
  OURBOX_SUBSTRATE_K3S_VERSION="${K3S_VERSION:-unknown}"
  OURBOX_SUBSTRATE_IMAGES_LOCK_SHA256="${OURBOX_PLATFORM_IMAGES_LOCK_SHA256:-unknown}"
}

