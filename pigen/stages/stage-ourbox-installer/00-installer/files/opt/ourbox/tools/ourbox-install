matchbox_partition_path() {
  local disk="$1"
  local part_num="$2"

  if [[ "${disk}" =~ [0-9]$ ]]; then
    printf '%s\n' "${disk}p${part_num}"
  else
    printf '%s\n' "${disk}${part_num}"
  fi
}

parse_sha256_file() {
  local file="$1"
  awk 'NF>=1 {print $1; exit}' "${file}"
}

resolve_path_within_root() {
  local root="$1"
  local label="$2"
  local relpath="$3"

  python3 - <<'PY' "${root}" "${label}" "${relpath}"
from pathlib import Path
import sys

root = Path(sys.argv[1]).resolve()
label = sys.argv[2]
relpath = sys.argv[3].strip()
if not relpath:
    raise SystemExit(f"{label} must be set")

candidate = (root / relpath).resolve()
try:
    candidate.relative_to(root)
except ValueError as exc:
    raise SystemExit(f"{label} must stay within the mission directory") from exc

print(candidate)
PY
}

resolve_mission_relpath() {
  resolve_path_within_root "${MISSION_ROOT}" "$1" "$2"
}

normalize_installer_config() {
  INSTALLER_ID="${INSTALLER_ID:-matchbox}"
  INSTALLER_VERSION="${INSTALLER_VERSION:-unknown}"
  INSTALLER_GIT_HASH="${INSTALLER_GIT_HASH:-unknown}"
  OURBOX_INSTALLER_SSH_TEARDOWN_ON_COMPLETE="${OURBOX_INSTALLER_SSH_TEARDOWN_ON_COMPLETE:-0}"
}

load_installer_config() {
  # shellcheck disable=SC1090
  [[ -f "${DEFAULTS_ENV}" ]] && source "${DEFAULTS_ENV}"
  normalize_installer_config
}

load_local_mission() {
  local mission_dump=""

  [[ -f "${MISSION_ROOT}/mission-manifest.json" ]] || die "mission-manifest.json missing from ${MISSION_ROOT}"

  mission_dump="$(
    python3 - <<'PY' "${MISSION_ROOT}/mission-manifest.json"
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as handle:
    manifest = json.load(handle)

if manifest.get("kind") != "ourbox-mission":
    raise SystemExit("mission-manifest.json must declare kind=ourbox-mission")
target = manifest.get("target") or {}
if target.get("id") != "matchbox":
    raise SystemExit("mission target id must be matchbox")
requested = manifest.get("requested")
if not isinstance(requested, dict) or not requested:
    raise SystemExit("mission-manifest.json must include a requested object")
resolved = manifest.get("resolved")
if not isinstance(resolved, dict) or not resolved:
    raise SystemExit("mission-manifest.json must include a resolved object")

selected_os = resolved.get("os") or {}
selected_substrate = resolved.get("selected_substrate") or {}
selected_applications = resolved.get("applications")

if not isinstance(selected_applications, dict) or not selected_applications:
    raise SystemExit("mission resolved.applications must be present")

catalog_relpath = str(selected_applications.get("catalog_relpath", "")).strip()
images_lock_relpath = str(selected_applications.get("images_lock_relpath", "")).strip()
selection_relpath = str(selected_applications.get("selection_relpath", "")).strip()

if not catalog_relpath:
    raise SystemExit("mission resolved.applications.catalog_relpath must be set")
if not images_lock_relpath:
    raise SystemExit("mission resolved.applications.images_lock_relpath must be set")
if not selection_relpath:
    raise SystemExit("mission resolved.applications.selection_relpath must be set")

values = [
    str(selected_os.get("selection_source", "")).strip(),
    str(selected_os.get("release_channel", "")).strip(),
    str(selected_os.get("artifact_ref", "")).strip(),
    str(selected_os.get("artifact_digest", "")).strip(),
    str((selected_os.get("payload") or {}).get("relpath", "")).strip(),
    str(selected_os.get("metadata_relpath", "")).strip(),
    str(selected_substrate.get("selection_source", "")).strip(),
    str(selected_substrate.get("release_channel", "")).strip(),
    str(selected_substrate.get("artifact_ref", "")).strip(),
    str(selected_substrate.get("artifact_digest", "")).strip(),
    str(selected_substrate.get("payload_relpath", "")).strip(),
    str(selected_substrate.get("manifest_relpath", "")).strip(),
    catalog_relpath,
    images_lock_relpath,
    selection_relpath,
]
print("\n".join(values))
PY
  )" || die "failed to parse mission-manifest.json"

  local mission_fields=()
  mapfile -t mission_fields <<<"${mission_dump}"
  [[ "${#mission_fields[@]}" -eq 15 ]] || die "mission-manifest.json parse produced an unexpected field set"

  INSTALL_SELECTION_SOURCE="${mission_fields[0]}"
  RELEASE_CHANNEL="${mission_fields[1]}"
  OS_ARTIFACT_REF="${mission_fields[2]}"
  OS_ARTIFACT_DIGEST="${mission_fields[3]}"
  PAYLOAD_PATH="$(resolve_mission_relpath "mission OS payload relpath" "${mission_fields[4]}")"
  PAYLOAD_META="$(resolve_mission_relpath "mission OS metadata relpath" "${mission_fields[5]}")"
  OURBOX_SUBSTRATE_SELECTION_SOURCE="${mission_fields[6]}"
  OURBOX_SUBSTRATE_RELEASE_CHANNEL="${mission_fields[7]}"
  OURBOX_SUBSTRATE_REF="${mission_fields[8]}"
  OURBOX_SUBSTRATE_DIGEST="${mission_fields[9]}"
  local substrate_payload=""
  substrate_payload="$(resolve_mission_relpath "mission substrate bundle relpath" "${mission_fields[10]}")"
  SUBSTRATE_MANIFEST_PATH="$(resolve_mission_relpath "mission substrate bundle manifest relpath" "${mission_fields[11]}")"
  MISSION_APPLICATION_CATALOG_PATH="$(resolve_mission_relpath "mission selected_applications.catalog_relpath" "${mission_fields[12]}")"
  MISSION_APPLICATION_IMAGES_LOCK_PATH="$(
    resolve_mission_relpath "mission selected_applications.images_lock_relpath" "${mission_fields[13]}"
  )"
  MISSION_SELECTED_APPLICATIONS_PATH="$(
    resolve_mission_relpath "mission selected_applications.selection_relpath" "${mission_fields[14]}"
  )"

  [[ -f "${PAYLOAD_PATH}" ]] || die "mission OS payload missing: ${PAYLOAD_PATH}"
  [[ -f "${PAYLOAD_META}" ]] || die "mission OS metadata missing: ${PAYLOAD_META}"
  [[ -f "${substrate_payload}" ]] || die "mission substrate bundle missing: ${substrate_payload}"
  [[ -f "${SUBSTRATE_MANIFEST_PATH}" ]] || die "mission substrate bundle manifest missing: ${SUBSTRATE_MANIFEST_PATH}"
  [[ -f "${MISSION_APPLICATION_CATALOG_PATH}" ]] || die "mission application catalog missing: ${MISSION_APPLICATION_CATALOG_PATH}"
  [[ -f "${MISSION_APPLICATION_IMAGES_LOCK_PATH}" ]] || {
    die "mission application images lock missing: ${MISSION_APPLICATION_IMAGES_LOCK_PATH}"
  }
  [[ -f "${MISSION_SELECTED_APPLICATIONS_PATH}" ]] || {
    die "mission selected applications file missing: ${MISSION_SELECTED_APPLICATIONS_PATH}"
  }

  local payload_sha_file="${PAYLOAD_PATH}.sha256"
  [[ -f "${payload_sha_file}" ]] || die "mission OS payload checksum missing: ${payload_sha_file}"
  PAYLOAD_SHA256="$(parse_sha256_file "${payload_sha_file}")"
  PAYLOAD_SHA256="${PAYLOAD_SHA256,,}"
  [[ "${PAYLOAD_SHA256}" =~ ^[0-9a-f]{64}$ ]] || die "mission OS payload checksum is invalid: ${payload_sha_file}"
  local actual_payload_sha=""
  actual_payload_sha="$(sha256sum "${PAYLOAD_PATH}" | awk '{print $1}')"
  [[ "${PAYLOAD_SHA256}" == "${actual_payload_sha}" ]] || die "mission OS payload SHA mismatch (expected ${PAYLOAD_SHA256}, got ${actual_payload_sha})"

  # shellcheck disable=SC1090
  source "${PAYLOAD_META}"

  rm -rf "${SUBSTRATE_EXTRACT_DIR}"
  mkdir -p "${SUBSTRATE_EXTRACT_DIR}"
  tar -xzf "${substrate_payload}" -C "${SUBSTRATE_EXTRACT_DIR}"

  [[ -f "${SUBSTRATE_EXTRACT_DIR}/manifest.env" ]] || die "mission substrate bundle extract is missing manifest.env"
  [[ -x "${SUBSTRATE_EXTRACT_DIR}/k3s/k3s" ]] || die "mission substrate bundle extract is missing k3s/k3s"
  [[ -f "${SUBSTRATE_EXTRACT_DIR}/k3s/k3s-images-arm64.tar" ]] \
    || die "mission substrate bundle extract is missing k3s/k3s-images-arm64.tar"
  [[ -f "${SUBSTRATE_EXTRACT_DIR}/platform/images.lock.json" ]] \
    || die "mission substrate bundle extract is missing platform/images.lock.json"
  [[ -f "${SUBSTRATE_EXTRACT_DIR}/platform/profile.env" ]] \
    || die "mission substrate bundle extract is missing platform/profile.env"
  find "${SUBSTRATE_EXTRACT_DIR}/platform/images" -maxdepth 1 -type f -name '*.tar' | grep -q . \
    || die "mission substrate bundle extract is missing platform image tars"

  cmp -s "${SUBSTRATE_EXTRACT_DIR}/manifest.env" "${SUBSTRATE_MANIFEST_PATH}" \
    || die "mission substrate bundle manifest does not match tarball manifest.env"

  # shellcheck disable=SC1090
  source "${SUBSTRATE_MANIFEST_PATH}"
  [[ "${OURBOX_SUBSTRATE_ARCH:-}" == "arm64" ]] \
    || die "mission substrate bundle arch mismatch: expected arm64, got ${OURBOX_SUBSTRATE_ARCH:-unknown}"

  OURBOX_SUBSTRATE_SOURCE="${OURBOX_SUBSTRATE_SOURCE:-unknown}"
  OURBOX_SUBSTRATE_REVISION="${OURBOX_SUBSTRATE_REVISION:-unknown}"
  OURBOX_SUBSTRATE_VERSION="${OURBOX_SUBSTRATE_VERSION:-unknown}"
  OURBOX_SUBSTRATE_CREATED="${OURBOX_SUBSTRATE_CREATED:-unknown}"
  OURBOX_SUBSTRATE_ARCH="${OURBOX_SUBSTRATE_ARCH:-unknown}"
  OURBOX_SUBSTRATE_PROFILE="${OURBOX_PLATFORM_PROFILE:-unknown}"
  OURBOX_SUBSTRATE_K3S_VERSION="${K3S_VERSION:-unknown}"
  OURBOX_SUBSTRATE_IMAGES_LOCK_SHA256="${OURBOX_PLATFORM_IMAGES_LOCK_SHA256:-unknown}"
}

