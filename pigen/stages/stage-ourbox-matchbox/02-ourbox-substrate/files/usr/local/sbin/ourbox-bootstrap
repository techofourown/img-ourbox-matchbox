#!/usr/bin/env bash
set -euo pipefail

log(){ echo "[$(date -Is)] $*"; }
die(){ echo "ERROR: $*" >&2; exit 1; }
kubectl_cmd(){ /usr/local/bin/k3s kubectl --kubeconfig "${KUBECONFIG_PATH}" "$@"; }

STATE_DIR="/var/lib/ourbox/state"
MARKER="${STATE_DIR}/bootstrap.done"
APPLIED_CONTRACT_STATE="${STATE_DIR}/platform-contract.env"
SELECTED_APP_SURFACE_STATE="${STATE_DIR}/selected-app-surface.json"
KUBECONFIG_PATH="/etc/rancher/k3s/k3s.yaml"
HOSTNAME="$(hostname)"
PLATFORM_CONTRACT_DIR="/opt/ourbox/substrate/platform"
RENDER_DIR="/run/ourbox-platform-rendered"
DESIRED_CONTRACT_STATE=""
PLATFORM_PROFILE_INPUT=""
SELECTED_APPS_FILE="${PLATFORM_CONTRACT_DIR}/selected-apps.json"
APPLICATION_CATALOG_FILE="${PLATFORM_CONTRACT_DIR}/catalog.json"
APPLICATION_IMAGES_LOCK_FILE="${PLATFORM_CONTRACT_DIR}/images.lock.json"
PLATFORM_IMAGES_LOCK_FILE="${PLATFORM_CONTRACT_DIR}/platform-images.lock.json"
RENDER_CONTRACT_HELP_CACHE=""

cleanup() {
  if [[ -n "${DESIRED_CONTRACT_STATE}" && -f "${DESIRED_CONTRACT_STATE}" ]]; then
    rm -f "${DESIRED_CONTRACT_STATE}"
  fi
}
trap cleanup EXIT

ensure_k3s_running() {
  systemctl is-enabled --quiet k3s.service 2>/dev/null || systemctl enable k3s.service
  systemctl is-active --quiet k3s.service 2>/dev/null || systemctl start k3s.service
}

render_contract_help() {
  if [[ -z "${RENDER_CONTRACT_HELP_CACHE}" ]]; then
    RENDER_CONTRACT_HELP_CACHE="$(
      python3 "${PLATFORM_CONTRACT_DIR}/tools/render-contract.py" --help 2>&1
    )" || die "platform-contract render-contract.py is not runnable: ${PLATFORM_CONTRACT_DIR}/tools/render-contract.py"
  fi
  printf '%s\n' "${RENDER_CONTRACT_HELP_CACHE}"
}

render_contract_supports_option() {
  local option="$1"
  grep -Fq -- "${option}" <<<"$(render_contract_help)"
}

require_render_contract_option() {
  local option="$1"
  local reason="$2"
  if ! render_contract_supports_option "${option}"; then
    die "${reason}. Rebuild with a compatible platform-contract artifact."
  fi
}

identity_output_value() {
  local identity_output="$1" key="$2"
  awk -F= -v wanted="${key}" '
    $1 == wanted {
      print substr($0, index($0, "=") + 1)
      exit
    }
  ' <<<"${identity_output}"
}

load_platform_profile_input() {
  local profile_env="${PLATFORM_CONTRACT_DIR}/profile.env"

  if [[ -n "${OURBOX_PLATFORM_PROFILE:-}" ]]; then
    PLATFORM_PROFILE_INPUT="${OURBOX_PLATFORM_PROFILE}"
    return 0
  fi

  if [[ -f "${profile_env}" ]]; then
    PLATFORM_PROFILE_INPUT="$(
      awk -F= '
        $1 == "OURBOX_PLATFORM_PROFILE" {
          print substr($0, index($0, "=") + 1)
          exit
        }
      ' "${profile_env}"
    )"
  fi

  [[ -n "${PLATFORM_PROFILE_INPUT}" ]] || \
    die "supported mission installs require OURBOX_PLATFORM_PROFILE or ${profile_env} with OURBOX_PLATFORM_PROFILE"
}

require_application_intent_files() {
  [[ -f "${APPLICATION_CATALOG_FILE}" ]] || \
    die "supported mission installs require ${APPLICATION_CATALOG_FILE}"
  [[ -f "${SELECTED_APPS_FILE}" ]] || \
    die "supported mission installs require ${SELECTED_APPS_FILE}"
  [[ -f "${APPLICATION_IMAGES_LOCK_FILE}" ]] || \
    die "supported mission installs require ${APPLICATION_IMAGES_LOCK_FILE}"
  [[ -f "${PLATFORM_IMAGES_LOCK_FILE}" ]] || \
    die "supported mission installs require ${PLATFORM_IMAGES_LOCK_FILE}"

  python3 - <<'PY' "${APPLICATION_CATALOG_FILE}" "${SELECTED_APPS_FILE}" "${APPLICATION_IMAGES_LOCK_FILE}"
import json
import pathlib
import sys

catalog_path = pathlib.Path(sys.argv[1])
selected_apps_path = pathlib.Path(sys.argv[2])
images_lock_path = pathlib.Path(sys.argv[3])
supported_selection_modes = {"catalog-defaults", "all-apps", "custom"}

with catalog_path.open("r", encoding="utf-8") as handle:
    catalog = json.load(handle)
with selected_apps_path.open("r", encoding="utf-8") as handle:
    selected = json.load(handle)
with images_lock_path.open("r", encoding="utf-8") as handle:
    images_lock = json.load(handle)

if catalog.get("schema") != 1:
    raise SystemExit(f"{catalog_path} must declare schema=1")
if catalog.get("kind") != "ourbox-application-catalog":
    raise SystemExit(f"{catalog_path} must declare kind=ourbox-application-catalog")
catalog_id = str(catalog.get("catalog_id", "")).strip()
if not catalog_id:
    raise SystemExit(f"{catalog_path} must declare catalog_id")
catalog_apps = catalog.get("apps")
if not isinstance(catalog_apps, list) or not catalog_apps:
    raise SystemExit(f"{catalog_path} must declare a non-empty apps list")
catalog_app_ids = set()
for app in catalog_apps:
    app_id = str(app.get("id", "")).strip()
    if not app_id:
        raise SystemExit(f"{catalog_path} contains an app without an id")
    if app_id in catalog_app_ids:
        raise SystemExit(f"{catalog_path} duplicates app id {app_id}")
    catalog_app_ids.add(app_id)

if selected.get("schema") != 1:
    raise SystemExit(f"{selected_apps_path} must declare schema=1")
if selected.get("kind") != "ourbox-selected-applications":
    raise SystemExit(f"{selected_apps_path} must declare kind=ourbox-selected-applications")
if str(selected.get("catalog_id", "")).strip() != catalog_id:
    raise SystemExit(f"{selected_apps_path} catalog_id must match {catalog_path}")
selection_mode = str(selected.get("selection_mode", "")).strip()
if selection_mode not in supported_selection_modes:
    raise SystemExit(
        f"{selected_apps_path} selection_mode must be one of catalog-defaults, all-apps, custom"
    )
selected_ids = selected.get("selected_app_ids")
if not isinstance(selected_ids, list) or not selected_ids:
    raise SystemExit(f"{selected_apps_path} must declare a non-empty selected_app_ids list")
seen_ids = set()
for raw_app_id in selected_ids:
    app_id = str(raw_app_id).strip()
    if not app_id:
        raise SystemExit(f"{selected_apps_path} contains an empty app id")
    if app_id in seen_ids:
        raise SystemExit(f"{selected_apps_path} duplicates app id {app_id}")
    if app_id not in catalog_app_ids:
        raise SystemExit(f"{selected_apps_path} references unknown app id {app_id}")
    seen_ids.add(app_id)

images = images_lock.get("images")
if not isinstance(images, list) or not images:
    raise SystemExit(f"{images_lock_path} must declare a non-empty images list")
for image in images:
    name = str(image.get("name", "")).strip()
    ref = str(image.get("ref", "")).strip()
    if not name:
        raise SystemExit(f"{images_lock_path} contains an image without a name")
    if not ref:
        raise SystemExit(f"{images_lock_path} contains an image without a ref")
PY
}

require_platform_contract_capabilities() {
  local identity_output required_key=""

  require_render_contract_option \
    "--selected-apps-file" \
    "supported mission installs require platform-contract render-contract.py to accept --selected-apps-file"
  require_render_contract_option \
    "--application-catalog" \
    "supported mission installs require platform-contract render-contract.py to accept --application-catalog"
  require_render_contract_option \
    "--images-lock-file" \
    "supported mission installs require platform-contract render-contract.py to accept --images-lock-file"
  require_render_contract_option \
    "--platform-images-lock-file" \
    "supported mission installs require platform-contract render-contract.py to accept --platform-images-lock-file"

  identity_output="$(
    "${PLATFORM_CONTRACT_DIR}/tools/contract-identity.sh" \
      --contract-dir "${PLATFORM_CONTRACT_DIR}" \
      --profile "${PLATFORM_PROFILE_INPUT}" \
      --box-host "${OURBOX_BOX_HOST:-${HOSTNAME}.local}" \
      --tls-mode "${OURBOX_TLS_MODE:-}" \
      --ingress-class "${OURBOX_INGRESS_CLASS:-}" \
      --storage-class "${OURBOX_STORAGE_CLASS:-}"
  )" || die "platform-contract contract-identity.sh failed while validating application metadata support"

  for required_key in \
    "OURBOX_APPLICATION_CATALOG_ID=" \
    "OURBOX_APPLICATION_SELECTION_MODE=" \
    "OURBOX_SELECTED_APPLICATION_IDS=" \
    "OURBOX_APPLICATION_CATALOG_SHA256=" \
    "OURBOX_APPLICATION_IMAGES_LOCK_SHA256="; do
    if ! grep -Fq -- "${required_key}" <<<"${identity_output}"; then
      die "platform-contract contract-identity.sh does not emit ${required_key%=} required for application metadata state tracking. Rebuild with a compatible platform-contract artifact."
    fi
  done

  if [[ -f "${SELECTED_APPS_FILE}" ]]; then
    for required_key in \
      "OURBOX_APPLICATION_CATALOG_ID" \
      "OURBOX_APPLICATION_SELECTION_MODE" \
      "OURBOX_SELECTED_APPLICATION_IDS"; do
      if [[ -z "$(identity_output_value "${identity_output}" "${required_key}")" ]]; then
        die "platform-contract contract-identity.sh leaves ${required_key} empty while selected application metadata is present. Rebuild with a compatible platform-contract artifact."
      fi
    done
    case "$(identity_output_value "${identity_output}" "OURBOX_APPLICATION_SELECTION_MODE")" in
      catalog-defaults|all-apps|custom) ;;
      *)
        die "platform-contract contract-identity.sh reports an unsupported OURBOX_APPLICATION_SELECTION_MODE while selected application metadata is present. Rebuild with a compatible platform-contract artifact."
        ;;
    esac
  fi

  if [[ -f "${APPLICATION_CATALOG_FILE}" ]] && [[ -z "$(identity_output_value "${identity_output}" "OURBOX_APPLICATION_CATALOG_SHA256")" ]]; then
    die "platform-contract contract-identity.sh leaves OURBOX_APPLICATION_CATALOG_SHA256 empty while application catalog metadata is present. Rebuild with a compatible platform-contract artifact."
  fi

  if [[ -f "${APPLICATION_IMAGES_LOCK_FILE}" ]] && [[ -z "$(identity_output_value "${identity_output}" "OURBOX_APPLICATION_IMAGES_LOCK_SHA256")" ]]; then
    die "platform-contract contract-identity.sh leaves OURBOX_APPLICATION_IMAGES_LOCK_SHA256 empty while application image metadata is present. Rebuild with a compatible platform-contract artifact."
  fi
}

resolve_desired_contract_state() {
  DESIRED_CONTRACT_STATE="$(mktemp "${TMPDIR:-/tmp}/ourbox-platform-state.XXXXXX")"
  "${PLATFORM_CONTRACT_DIR}/tools/contract-identity.sh" \
    --contract-dir "${PLATFORM_CONTRACT_DIR}" \
    --profile "${PLATFORM_PROFILE_INPUT}" \
    --box-host "${OURBOX_BOX_HOST:-${HOSTNAME}.local}" \
    --tls-mode "${OURBOX_TLS_MODE:-}" \
    --ingress-class "${OURBOX_INGRESS_CLASS:-}" \
    --storage-class "${OURBOX_STORAGE_CLASS:-}" \
    > "${DESIRED_CONTRACT_STATE}"
  # shellcheck disable=SC1090,SC1091
  source "${DESIRED_CONTRACT_STATE}"
}

current_contract_matches() {
  [[ -f "${MARKER}" ]] || return 1
  [[ -f "${APPLIED_CONTRACT_STATE}" ]] || return 1
  cmp -s "${APPLIED_CONTRACT_STATE}" "${DESIRED_CONTRACT_STATE}"
}

# hard requirement for product posture: don't bootstrap platform onto OS disk
if ! mountpoint -q /var/lib/ourbox; then
  echo "ERROR: /var/lib/ourbox is not mounted. Refusing to bootstrap." >&2
  exit 1
fi

mkdir -p \
  "$STATE_DIR" \
  "/var/lib/ourbox/device" \
  "/var/lib/ourbox/secrets" \
  "/var/lib/ourbox/k3s/agent/images"

load_platform_profile_input
require_application_intent_files
require_platform_contract_capabilities
resolve_desired_contract_state

if current_contract_matches; then
  log "Stored platform contract state matches shipped contract; ensuring k3s is running and skipping reapply"
  ensure_k3s_running
  exit 0
fi

if [[ -f "${MARKER}" ]]; then
  log "Bootstrap marker exists but shipped contract state changed (or was never recorded); reapplying"
fi

"${PLATFORM_CONTRACT_DIR}/tools/check-target-prereqs.sh"

# device_id (stable)
if [[ ! -f /var/lib/ourbox/device/device_id ]]; then
  cat /proc/sys/kernel/random/uuid > /var/lib/ourbox/device/device_id
fi
DEVICE_ID="$(cat /var/lib/ourbox/device/device_id)"

# k3s token (stable)
if [[ ! -f /var/lib/ourbox/secrets/k3s_token ]]; then
  head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > /var/lib/ourbox/secrets/k3s_token
  chmod 0600 /var/lib/ourbox/secrets/k3s_token
fi
TOKEN="$(cat /var/lib/ourbox/secrets/k3s_token)"

# Write k3s config (data-dir on DATA disk)
# CRITICAL: keep servicelb disabled — we use Traefik hostPort instead.
# DO NOT set node-ip or bind-address — let k3s auto-detect from the default route.
# This is the key difference from the broken LOI branch.
mkdir -p /etc/rancher/k3s
cat > /etc/rancher/k3s/config.yaml <<EOF_CONFIG
token: "${TOKEN}"
data-dir: /var/lib/ourbox/k3s
write-kubeconfig-mode: "0644"
tls-san:
  - "127.0.0.1"
  - "${HOSTNAME}"
  - "${HOSTNAME}.local"
disable:
  - servicelb
EOF_CONFIG

# Write Traefik HelmChartConfig to k3s auto-deploy directory.
# This configures Traefik to use hostPort 80/443 directly instead of ServiceLB.
# Placed here BEFORE k3s starts so the chart picks it up on first deploy.
AUTODEPLOY_DIR="/var/lib/ourbox/k3s/server/manifests"
mkdir -p "${AUTODEPLOY_DIR}"
cat > "${AUTODEPLOY_DIR}/traefik-config.yaml" <<'EOF_TRAEFIK'
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    ports:
      web:
        hostPort: 80
      websecure:
        hostPort: 443
EOF_TRAEFIK

log "Hydrating substrate image tars into /var/lib/ourbox/k3s/agent/images"
shopt -s nullglob
for tar in /opt/ourbox/substrate/k3s/*.tar /opt/ourbox/substrate/platform/images/*.tar; do
  base="$(basename "${tar}")"
  dst="/var/lib/ourbox/k3s/agent/images/${base}"
  if [[ -f "${dst}" ]]; then
    continue
  fi
  cp -f "${tar}" "${dst}"
done
shopt -u nullglob

log "Hydrated tar files:"
ls -1 /var/lib/ourbox/k3s/agent/images/*.tar 2>/dev/null || true

# Fail fast with a clear message if memory controller isn't available
if [[ -f /sys/fs/cgroup/cgroup.controllers ]] && ! grep -qw memory /sys/fs/cgroup/cgroup.controllers; then
  echo "ERROR: cgroup v2 memory controller not enabled. k3s will fail." >&2
  echo "Expected: 'memory' in /sys/fs/cgroup/cgroup.controllers" >&2
  echo "Fix: ensure /boot/firmware/cmdline.txt includes:" >&2
  echo "  cgroup_enable=cpuset cgroup_enable=memory cgroup_memory=1" >&2
  exit 1
fi

# Start k3s (enabled only after hydration prep)
ensure_k3s_running

# Wait for kubeconfig + API
log "Waiting for k3s kubeconfig + API..."
for i in $(seq 1 600); do
  if [[ -f "${KUBECONFIG_PATH}" ]]; then
    if kubectl_cmd get nodes >/dev/null 2>&1; then
      log "k3s API is up (after ${i}s)"
      break
    fi
  fi

  # If k3s is hard-failed, exit early with useful logs
  if systemctl is-failed --quiet k3s.service; then
    echo "ERROR: k3s.service is failed. Recent logs:" >&2
    journalctl -u k3s --no-pager -n 120 >&2 || true
    exit 1
  fi

  if (( i % 10 == 0 )); then
    log "still waiting... (${i}/600)"
  fi
  sleep 1
done

# Final gate
if ! kubectl_cmd get nodes >/dev/null 2>&1; then
  echo "ERROR: k3s API never became ready. Recent logs:" >&2
  journalctl -u k3s --no-pager -n 200 >&2 || true
  exit 1
fi

log "Rendering upstream platform contract"
rm -rf "${RENDER_DIR}"
render_cmd=(
  python3 "${PLATFORM_CONTRACT_DIR}/tools/render-contract.py"
  --contract-root "${PLATFORM_CONTRACT_DIR}"
  --output-dir "${RENDER_DIR}"
  --profile "${PLATFORM_PROFILE_INPUT}"
  --selected-apps-file "${SELECTED_APPS_FILE}"
  --application-catalog "${APPLICATION_CATALOG_FILE}"
  --images-lock-file "${APPLICATION_IMAGES_LOCK_FILE}"
  --platform-images-lock-file "${PLATFORM_IMAGES_LOCK_FILE}"
  --box-host "${BOX_HOST}"
  --tls-mode "${TLS_MODE}"
  --ingress-class "${INGRESS_CLASS}"
  --storage-class "${STORAGE_CLASS}"
)
log "Applying mission-selected application metadata from ${APPLICATION_CATALOG_FILE}, ${SELECTED_APPS_FILE}, ${APPLICATION_IMAGES_LOCK_FILE}, and ${PLATFORM_IMAGES_LOCK_FILE}"
"${render_cmd[@]}"
[[ -f "${RENDER_DIR}/selected-app-surface.json" ]] || \
  die "rendered platform contract is missing selected-app-surface.json"

log "Applying rendered platform manifests"
kubectl_cmd apply -f "${RENDER_DIR}/manifests"

log "Running upstream runtime verification"
"${PLATFORM_CONTRACT_DIR}/tools/verify-runtime.sh" \
  --kubeconfig "${KUBECONFIG_PATH}" \
  --contract-dir "${PLATFORM_CONTRACT_DIR}" \
  --render-dir "${RENDER_DIR}"

install -D -m 0644 "${DESIRED_CONTRACT_STATE}" "${APPLIED_CONTRACT_STATE}"
install -D -m 0644 "${RENDER_DIR}/selected-app-surface.json" "${SELECTED_APP_SURFACE_STATE}"
date -Is > "$MARKER"
systemctl restart ourbox-mdns-aliases.service ourbox-status.service || true
echo "OurBox bootstrap complete. device_id=${DEVICE_ID}"
